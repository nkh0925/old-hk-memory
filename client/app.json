{
  "expo": {
    "name": "Old Hong Kong Memory",
    "slug": "old-hk-memory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "oldhkmemory",
    "entryPoint": "./node_modules/expo-router/entry.js",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oldhkmemory.app",
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture memories of old Hong Kong.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to share Hong Kong memories.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show nearby historical sites."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.oldhkmemory.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB0mNQTxq6v12u34KqR2F9s6ITBs6J4Bdo"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Old Hong Kong Memory to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Old Hong Kong Memory to access your photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Old Hong Kong Memory to access your camera."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
